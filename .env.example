# Environment variables for the harness host process.
# The harness does NOT load this file automatically — copy values into your shell
# (or `export $(grep -v '^#' .env | xargs)`) before `npm run harness -- ...`.
# Never commit real secrets. Never write these into a generated workspace.

# -----------------------------------------------------------------------------
# Optional — operational knobs
# -----------------------------------------------------------------------------
# These live here rather than in the recipe: they are what you change while
# debugging a run, and editing the recipe for them produces a spurious project
# diff (and on a template branch, gets committed by mistake).
# Precedence: CLI flag > environment > recipe > harness default.

# Repair attempts per run before the loop stops.
# HARNESS_MAX_ATTEMPTS=3

# Wall-clock budget for a single agent invocation, in seconds.
# HARNESS_AGENT_TIMEOUT_S=3600

# Kill a generator/validator agent if its stream goes silent (default: 90000 = 90s).
# HARNESS_AGENT_IDLE_TIMEOUT_MS=90000

# Override the agent preset's models. The first attempt of a cycle uses MODEL;
# repairs use FIX_MODEL, except after an attempt that fixed nothing, which
# escalates back to MODEL.
# HARNESS_MODEL=opus
# HARNESS_FIX_MODEL=sonnet

# Set to 1 to always use HARNESS_MODEL, disabling the cheaper-on-repair switch.
# HARNESS_NO_MODEL_SWITCH=1

# Skills git source. Default is hedera-dev/hedera-skills @ master. Product plugins
# are discovered automatically; authoring/CLI plugins are not offered.
# HARNESS_SKILLS_REPO=https://github.com/hedera-dev/hedera-skills.git
# HARNESS_SKILLS_REF=master

# -----------------------------------------------------------------------------
# CHAIN only — Hedera testnet operator for chainValidation
# -----------------------------------------------------------------------------
# Create an ECDSA account at https://portal.hedera.com (not ED25519).
# Required when a spec has chainValidation.enabled: true.

HEDERA_OPERATOR_ID=0.0.xxxx
HEDERA_OPERATOR_KEY=0x...
