# Environment variables for the harness host process.
# The harness does NOT load this file automatically — copy values into your shell
# (or `export $(grep -v '^#' .env | xargs)`) before `npm run harness -- ...`.
# Never commit real secrets. Never write these into a generated workspace.

# -----------------------------------------------------------------------------
# Optional — agent process timeouts
# -----------------------------------------------------------------------------
# Kill a generator/validator agent if its stream goes silent (default: 600000 = 10 min).
# HARNESS_AGENT_IDLE_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# Tier 3.5 only — Hedera testnet operator for chainValidation
# -----------------------------------------------------------------------------
# Create an ECDSA account at https://portal.hedera.com (not ED25519).
# Required when a spec has chainValidation.enabled: true.

HEDERA_OPERATOR_ID=0.0.xxxx
HEDERA_OPERATOR_KEY=0x...
