{
  "name": "hedera-harness",
  "version": "2.0.0-rc.4",
  "description": "Agentic harness for scaffolding and iteratively developing hedera dapps projects (init + run).",
  "type": "module",
  "bin": {
    "hedera-harness": "./dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "skeletons",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "harness": "npm run build --silent && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node -e \"require('node:fs').rmSync('.tmp-test', { recursive: true, force: true })\"",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build --silent && node --test test/browser/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedera-dev/hedera-harness.git"
  },
  "homepage": "https://github.com/hedera-dev/hedera-harness#readme",
  "bugs": {
    "url": "https://github.com/hedera-dev/hedera-harness/issues"
  },
  "keywords": [
    "hedera",
    "scaffold-hbar",
    "harness",
    "agentic",
    "cli"
  ],
  "dependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "playwright": "^1.61.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
