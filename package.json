{
  "name": "hedera-harness",
  "version": "1.1.1",
  "description": "Agentic harness for scaffolding and iteratively extending scaffold-hbar projects (init + run).",
  "type": "module",
  "bin": {
    "hedera-harness": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills-index.json",
    "skeletons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "harness": "npm run build --silent && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "smoke:pack": "bash scripts/smoke-pack.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedera-dev/hedera-harness.git"
  },
  "homepage": "https://github.com/hedera-dev/hedera-harness#readme",
  "bugs": {
    "url": "https://github.com/hedera-dev/hedera-harness/issues"
  },
  "keywords": [
    "hedera",
    "scaffold-hbar",
    "harness",
    "agentic",
    "cli"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "@hiero-ledger/sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "@types/node": "^26.1.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
